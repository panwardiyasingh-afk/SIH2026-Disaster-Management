# Development target used by Vite's /backend proxy.
# Change this if your FastAPI/Django/Node backend uses another host or port.
VITE_BACKEND_TARGET=http://127.0.0.1:8000

# Leave unset during local development to use the proxy above.
# For production, set the complete public backend URL instead.
# VITE_API_BASE_URL=https://api.example.gov.in
